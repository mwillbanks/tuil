      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../tooling/build/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil-core": "workspace:*",
    "@mwillbanks/tuil-events": "workspace:*"
  },
  "files": [
    "dist"
