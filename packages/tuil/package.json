{
  "name": "@mwillbanks/tuil",
  "version": "0.2.0",
  "description": "A renderer-neutral terminal application runtime with React Ink compatibility.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "packages/tuil"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "renderer-neutral",
    "cell-buffer",
    "typescript",
    "bun"
  ],
  "type": "module",
  "sideEffects": false,
  "tuil": {
    "skills": "./skills"
  },
  "bin": {
    "tuil": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../tooling/build/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil-core": "workspace:*",
    "@mwillbanks/tuil-editor": "workspace:*",
    "@mwillbanks/tuil-events": "workspace:*",
    "@mwillbanks/tuil-focus": "workspace:*",
    "@mwillbanks/tuil-hotkeys": "workspace:*",
    "@mwillbanks/tuil-logging": "workspace:*",
    "@mwillbanks/tuil-operations": "workspace:*",
    "@mwillbanks/tuil-pointer": "workspace:*",
    "@mwillbanks/tuil-plugin": "workspace:*",
    "@mwillbanks/tuil-renderer": "workspace:*",
    "@mwillbanks/tuil-router": "workspace:*",
    "@mwillbanks/tuil-scroll": "workspace:*",
    "@mwillbanks/tuil-streaming": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "@mwillbanks/tuil-workflow": "workspace:*"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "files": [
    "dist"
  ]
}
