{
  "name": "@mwillbanks/tuil-cli",
  "version": "0.2.0",
  "description": "CLI for initializing tuil applications and installing source-owned registry items and skills.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "cli"
  ],
  "type": "module",
  "tuil": {
    "skills": "./skills"
  },
  "bin": {
    "tuil": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun ../../tooling/build/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil": "workspace:*",
    "@mwillbanks/tuil-core": "workspace:*",
    "@mwillbanks/tuil-editor": "workspace:*",
    "@mwillbanks/tuil-focus": "workspace:*",
    "@mwillbanks/tuil-form": "workspace:*",
    "@mwillbanks/tuil-hotkeys": "workspace:*",
    "@mwillbanks/tuil-ink": "workspace:*",
    "@mwillbanks/tuil-operations": "workspace:*",
    "@mwillbanks/tuil-registry": "workspace:*",
    "@mwillbanks/tuil-router": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "@mwillbanks/tuil-workflow": "workspace:*",
    "ink": "catalog:",
    "react": "catalog:"
  },
  "files": [
    "dist"
  ]
}
