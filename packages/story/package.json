{
  "name": "@mwillbanks/tuil-story",
  "version": "1.0.0",
  "description": "Portable tuil stories, browser bridges, snapshots, documentation, and Storybook adapters.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "packages/story"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "story"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "import": "./dist/storybook.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    }
  },
  "scripts": {
    "build": "bun ../../tooling/build/package.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil": "workspace:*",
    "@mwillbanks/tuil-core": "workspace:*",
    "@mwillbanks/tuil-testing": "workspace:*",
    "@mwillbanks/tuil-testing-ink": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "ansi-to-html": "^0.7.2",
    "chalk": "^5.6.2"
  },
  "devDependencies": {
    "react-dom": "catalog:"
  },
  "peerDependencies": {
    "@storybook/react": "^10.5.4",
    "ink": "catalog:",
    "ink-testing-library": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "@storybook/react": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ]
}
