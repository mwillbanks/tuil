{
  "name": "tuil-workspace",
  "description": "A Bun monorepo for tuil, a production-ready React terminal UI framework and ecosystem.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-table": "^9.3.1",
      "@tanstack/react-virtual": "^3.14.26",
      "@tanstack/pacer": "^0.23.1",
      "diff": "^9.0.0",
      "ink": "^8.0.0",
      "ink-testing-library": "^4.0.0",
      "nusm": "^1.3.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "slice-ansi": "^10.0.1",
      "string-width": "^9.0.0"
    }
  },
  "scripts": {
    "build": "bun tooling/build/workspace.ts",
    "build:all": "bun tooling/build/workspace.ts --all",
    "registry:build": "bun tooling/registry/build.ts",
    "registry:check": "bun tooling/registry/check.ts",
    "test": "bun run test:unit",
    "test:browser": "bun tooling/browser/acceptance.ts",
    "test:changed": "bun --config=tooling/bunfig.changed.toml test --changed=HEAD --pass-with-no-tests --max-concurrency=1",
    "test:renderer": "bun --config=tooling/bunfig.changed.toml test packages/renderer packages/cell tests/functional/packages/ink/src/renderer-backend.test.ts tests/regression/layout-projection.test.ts tests/regression/renderer-parity.test.ts tests/regression/ink-static-lifecycle.test.tsx --bail",
    "test:editors": "bun --config=tooling/bunfig.changed.toml test packages/editor tests/functional/registry/phase5.test.tsx --bail",
    "test:pointer": "bun --config=tooling/bunfig.changed.toml test packages/pointer packages/scroll --bail",
    "test:logging": "bun --config=tooling/bunfig.changed.toml test packages/logging tests/functional/packages/log-viewer/src/log-viewer.test.ts --bail",
    "test:devtools": "bun --config=tooling/bunfig.changed.toml test packages/devtools packages/protocol tests/functional/packages/devtools/src/devtools.test.tsx --bail",
    "benchmark:terminal": "bun benchmarks/terminal.ts",
    "test:coverage": "bun tests/helpers/coverage-qualify.ts",
    "publication:verify": "bun tooling/build/publication-smoke.ts",
    "lint": "oxlint",
    "format:check": "bun fmt --check",
    "format": "bun fmt",
    "fallow": "fallow dead-code --format json --quiet --fail-on-issues && fallow dupes --format json --quiet",
    "fallow:audit": "fallow audit --max-crap 200 --coverage coverage/coverage-final.json --runtime-coverage coverage/coverage-final.json --format github-annotations --quiet --fail-on-issues",
    "fallow:health": "fallow health --min-score 77 --hotspots --targets --format json --quiet --fail-on-issues",
    "security": "osv-scanner scan source --config=osv-scanner.toml --lockfile=bun.lock",
    "release": "bun run validate:all && bun run publication:verify && bun tooling/release/publish.ts",
    "playground": "bun --cwd apps/playground start",
    "showcase": "bun --cwd apps/showcase start",
    "storybook": "bun --cwd apps/showcase storybook",
    "docs": "bun run --cwd apps/docs dev",
    "docs:check": "TUIL_DOCS_BASE_PATH=/tuil bun run --cwd apps/docs validate",
    "tuil": "bun packages/cli/src/bin.ts",
    "prepare": "husky",
    "checks:watch": "bun tooling/checks/runner.ts watch",
    "checks:status": "bun tooling/checks/runner.ts status",
    "validate": "bun run format:check && bun run --cwd packages/ghostty-web build && bun check && bun run lint && bun run registry:check && bun run build && bun run test:acceptance && bun run fallow && bun run fallow:health",
    "validate:all": "bun run format:check && bun run --cwd packages/ghostty-web build && bun check && bun run lint && bun run registry:check && bun run build:all && bun run test:acceptance && bun run fallow && bun run fallow:health",
    "doctor:full": "react-doctor --yes --verbose --no-telemetry",
    "doctor:changed": "react-doctor --yes --verbose --no-telemetry --scope changed --include-untracked",
    "test:unit": "bun tooling/checks/suites.ts unit",
    "test:functional": "bun tooling/checks/suites.ts functional",
    "test:regression": "bun tooling/checks/suites.ts regression",
    "test:inventory": "bun tooling/checks/suites.ts inventory",
    "test:acceptance": "bun run test:coverage",
    "test:browser:root": "TUIL_DOCS_BASE_PATH=/ bun run --cwd apps/docs ../../tooling/docs/export.tsx && TUIL_DOCS_BASE_PATH=/ bun tooling/docs/validate-static.ts && TUIL_DOCS_BASE_PATH=/ bun run test:browser"
  },
  "dependencies": {
    "@opentui/core": "^0.9.7",
    "@tanstack/react-table": "catalog:",
    "diff": "catalog:",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fallow-cli/fallow-cov": "^0.5.1",
    "@mwillbanks/tuil": "workspace:*",
    "@mwillbanks/tuil-cell": "workspace:*",
    "@mwillbanks/tuil-code": "workspace:*",
    "@mwillbanks/tuil-content": "workspace:*",
    "@mwillbanks/tuil-core": "workspace:*",
    "@mwillbanks/tuil-devtools": "workspace:*",
    "@mwillbanks/tuil-editor": "workspace:*",
    "@mwillbanks/tuil-focus": "workspace:*",
    "@mwillbanks/tuil-form": "workspace:*",
    "@mwillbanks/tuil-hotkeys": "workspace:*",
    "@mwillbanks/tuil-ink": "workspace:*",
    "@mwillbanks/tuil-log-viewer": "workspace:*",
    "@mwillbanks/tuil-logging": "workspace:*",
    "@mwillbanks/tuil-operations": "workspace:*",
    "@mwillbanks/tuil-plugin": "workspace:*",
    "@mwillbanks/tuil-registry": "workspace:*",
    "@mwillbanks/tuil-renderer": "workspace:*",
    "@mwillbanks/tuil-router": "workspace:*",
    "@mwillbanks/tuil-scroll": "workspace:*",
    "@mwillbanks/tuil-story": "workspace:*",
    "@mwillbanks/tuil-streaming": "workspace:*",
    "@mwillbanks/tuil-testing": "workspace:*",
    "@mwillbanks/tuil-testing-ink": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "@mwillbanks/tuil-virtual": "workspace:*",
    "@mwillbanks/tuil-workflow": "workspace:*",
    "@tanstack/react-form": "catalog:",
    "@types/bun": "^1.4.5",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ansi-to-html": "^0.7.2",
    "fallow": "^3.43.2",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "react-doctor": "^0.9.23",
    "react-dom": "catalog:",
    "ts-morph": "28.0.0"
  },
  "overrides": {
    "@tanstack/devtools-event-client": "0.5.1",
    "brace-expansion": "5.0.13",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.9",
    "source-map-js": "1.2.2"
  }
}
