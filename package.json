{
  "name": "tuil-workspace",
  "description": "A Bun monorepo for tuil, a production-ready React terminal UI framework and ecosystem.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun"
  ],
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "overrides": {
    "brace-expansion": "5.0.9",
    "chalk": "6.0.0",
    "fast-uri": "3.1.5",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@tanstack/react-form": "^1.33.5",
      "@tanstack/react-table": "^9.1.2",
      "@tanstack/react-virtual": "^3.14.10",
      "@tanstack/pacer": "^0.22.0",
      "diff": "^9.0.0",
      "ink": "^7.1.1",
      "ink-testing-library": "^4.0.0",
      "nusm": "^1.1.1",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "slice-ansi": "^9.0.0",
      "string-width": "^8.2.2"
    }
  },
  "scripts": {
    "build": "bun tooling/build/workspace.ts",
    "build:all": "bun tooling/build/workspace.ts --all",
    "registry:build": "bun tooling/registry/build.ts",
    "registry:check": "bun tooling/registry/check.ts",
    "test": "bun test --bail --max-concurrency=1 && bun tooling/coverage/check.ts && bun tooling/coverage/lcov-to-istanbul.ts",
    "test:browser": "bun tooling/browser/acceptance.ts",
    "test:changed": "bun --config=tooling/bunfig.changed.toml test --changed=HEAD --pass-with-no-tests --max-concurrency=1",
    "test:renderer": "bun --config=tooling/bunfig.changed.toml test packages/renderer packages/cell packages/ink/src/renderer-backend.test.ts --bail",
    "test:editors": "bun --config=tooling/bunfig.changed.toml test packages/editor registry/phase5.test.tsx --bail",
    "test:pointer": "bun --config=tooling/bunfig.changed.toml test packages/pointer packages/scroll --bail",
    "test:logging": "bun --config=tooling/bunfig.changed.toml test packages/logging packages/log-viewer --bail",
    "test:devtools": "bun --config=tooling/bunfig.changed.toml test packages/devtools packages/protocol --bail",
    "benchmark:terminal": "bun benchmarks/terminal.ts",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text --max-concurrency=1 && bun tooling/coverage/check.ts && bun tooling/coverage/lcov-to-istanbul.ts",
    "publication:verify": "bun tooling/build/publication-smoke.ts",
    "typecheck": "bun run --cwd packages/ghostty-web build && tsc --noEmit",
    "check": "bun run format:check && bun run registry:check && bun run typecheck && bun run test && bun run build && bun run fallow && bun run fallow:health",
    "check:all": "bun run format:check && bun run registry:check && bun run typecheck && bun run test && bun run build:all && bun run fallow && bun run fallow:health",
    "lint": "bun biome check . --reporter concise --error-on-warnings",
    "format:check": "bun biome check . --reporter concise --error-on-warnings",
    "format": "bun biome check . --unsafe --write --reporter concise",
    "fallow": "fallow --skip health --format json --quiet --fail-on-issues",
    "fallow:audit": "fallow audit --max-crap 200 --runtime-coverage coverage/runtime-coverage.json --format github-annotations --quiet --fail-on-issues",
    "fallow:health": "fallow health --min-score 77 --hotspots --targets --format json --quiet --fail-on-issues",
    "security": "osv-scanner scan source --config=osv-scanner.toml --lockfile=bun.lock",
    "release": "bun run check:all && bun run publication:verify && bun tooling/release/publish.ts",
    "playground": "bun --cwd apps/playground start",
    "showcase": "bun --cwd apps/showcase start",
    "storybook": "bun --cwd apps/showcase storybook",
    "docs": "bun run --cwd apps/docs dev",
    "docs:check": "bun run --cwd apps/docs check",
    "tuil": "bun packages/cli/src/bin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentui/core": "^0.5.10",
    "@tanstack/react-table": "catalog:",
    "diff": "catalog:",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fallow-cli/fallow-cov": "^0.4.1",
    "@tanstack/pacer": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ansi-to-html": "^0.7.2",
    "fallow": "^3.21.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.4.1",
    "nusm": "catalog:",
    "playwright": "^1.62.1",
    "react-dom": "catalog:",
    "slice-ansi": "catalog:",
    "string-width": "catalog:",
    "ts-morph": "28.0.0",
    "typescript": "^7.0.2"
  }
}
