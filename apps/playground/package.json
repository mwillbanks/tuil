{
  "name": "@mwillbanks/tuil-playground",
  "version": "0.1.0",
  "description": "Native terminal playground for exploring and validating the tuil ecosystem.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "apps/playground"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "playground"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun src/index.tsx",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil": "workspace:*",
    "@mwillbanks/tuil-devtools": "workspace:*",
    "@mwillbanks/tuil-ink": "workspace:*",
    "@mwillbanks/tuil-testing": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "react": "catalog:",
    "ink": "catalog:"
  }
}
