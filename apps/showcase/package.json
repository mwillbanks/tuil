{
  "name": "@mwillbanks/tuil-showcase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun src/index.tsx",
    "storybook": "bun src/with-story-server.ts storybook",
    "build:storybook": "storybook build --output-dir dist-storybook",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external && bun run build:storybook",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil": "workspace:*",
    "@mwillbanks/tuil-focus": "workspace:*",
    "@mwillbanks/tuil-form": "workspace:*",
    "@mwillbanks/tuil-ink": "workspace:*",
    "@mwillbanks/tuil-operations": "workspace:*",
    "@mwillbanks/tuil-router": "workspace:*",
    "@mwillbanks/tuil-story": "workspace:*",
    "@mwillbanks/tuil-testing": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "@mwillbanks/tuil-virtual": "workspace:*",
    "@mwillbanks/tuil-workflow": "workspace:*",
    "@tanstack/pacer": "catalog:",
    "@tanstack/react-form": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "diff": "catalog:",
    "ink": "catalog:",
    "ink-testing-library": "catalog:",
    "react": "catalog:",
    "slice-ansi": "catalog:",
    "string-width": "catalog:"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "storybook": "^10.5.4",
    "vite": "^8.1.5"
  }
}
