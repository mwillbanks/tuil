{
  "name": "@mwillbanks/tuil-showcase",
  "version": "0.1.0",
  "description": "Portable story showcase and browser bridge for tuil terminal applications.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "apps/showcase"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "showcase"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun run browser",
    "browser": "bun run build:browser && bun src/serve.ts",
    "storybook": "bun run browser",
    "build:browser": "bun run --cwd ../../packages/ghostty-web build && bun src/build-browser.ts",
    "build:storybook": "bun run build:browser",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external && bun run build:browser",
    "check:types": "bun check",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil-ghostty-web": "workspace:*",
    "@mwillbanks/tuil-story": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "react": "catalog:",
    "ink": "catalog:",
    "ink-testing-library": "catalog:",
    "react-dom": "catalog:"
  }
}
