{
  "name": "@mwillbanks/tuil-showcase",
  "version": "0.1.0",
  "description": "Portable story showcase and browser bridge for tuil terminal applications.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "apps/showcase"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "showcase"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun src/index.tsx",
    "storybook": "bun src/with-story-server.ts storybook",
    "build:storybook": "storybook build --output-dir dist-storybook",
    "build": "bun build src/index.tsx --outdir dist --target bun --packages external && bun run build:storybook",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@mwillbanks/tuil-story": "workspace:*",
    "@mwillbanks/tuil-theme": "workspace:*",
    "react": "catalog:",
    "ink": "catalog:",
    "ink-testing-library": "catalog:"
  },
  "devDependencies": {
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "storybook": "^10.5.4",
    "vite": "^8.1.5"
  }
}
