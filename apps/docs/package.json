{
  "name": "@mwillbanks/tuil-docs",
  "version": "0.1.0",
  "description": "Documentation and interactive guides for the tuil terminal UI framework.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "docs"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bun run --cwd ../../packages/ghostty-web build && bun --cwd ../.. tooling/docs/generate-reference.ts && bun --cwd ../.. tooling/docs/prepare-assets.ts",
    "dev": "bun run prepare:assets && next dev",
    "build": "bun run prepare:assets && next build && bun ../../tooling/docs/validate-static.ts",
    "typecheck": "bun run prepare:assets && fumadocs-mdx && tsc --noEmit",
    "lint": "bun biome check . --reporter concise --error-on-warnings",
    "test": "bun test --bail",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@fumadocs/story": "^1.5.1",
    "@phosphor-icons/react": "^2.1.10",
    "@mwillbanks/tuil-ghostty-web": "workspace:*",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.17.6",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-ui": "^16.17.6",
    "geist": "^1.8.1",
    "lucide-react": "^1.32.0",
    "next": "^16.4.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.17.0",
    "zbsearch": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5"
  }
}
