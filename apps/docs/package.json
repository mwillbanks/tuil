{
  "name": "@mwillbanks/tuil-docs",
  "version": "0.1.0",
  "description": "Documentation and interactive guides for the tuil terminal UI framework.",
  "license": "MIT",
  "homepage": "https://mwillbanks.github.io/tuil/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwillbanks/tuil.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/mwillbanks/tuil/issues"
  },
  "keywords": [
    "tuil",
    "terminal-ui",
    "react",
    "ink",
    "typescript",
    "bun",
    "docs"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bun run --cwd ../../packages/ghostty-web build && bun --cwd ../.. tooling/docs/generate-reference.ts && bun --cwd ../.. tooling/docs/prepare-assets.ts",
    "dev": "bun run prepare:assets && bun --watch ../../tooling/docs/dev.ts",
    "build": "bun run prepare:assets && bun ../../tooling/docs/export.tsx && bun ../../tooling/docs/validate-static.ts",
    "lint": "bun run --cwd ../.. lint apps/docs/src tooling/docs",
    "test": "bun test --bail",
    "validate": "bun run build && bun fmt --check . && bun check --no-script --project tsconfig.json && bun run lint && bun run test"
  },
  "dependencies": {
    "@fumadocs/story": "^1.5.4",
    "@phosphor-icons/react": "^2.1.10",
    "@mwillbanks/tuil-ghostty-web": "workspace:*",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "^16.19.5",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-ui": "^16.19.5",
    "lucide-react": "^1.75.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "^4.3.5",
    "takumi-js": "^2.20.0",
    "zbsearch": "^4.0.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6"
  }
}
