{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": false,
    "types": ["bun", "react"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "paths": {
      "@/*": ["./apps/docs/src/*"],
      "@/.source": ["./apps/docs/.source/server.ts"],
      "@mwillbanks/tuil": ["./packages/tuil/src/index.ts"],
      "@mwillbanks/tuil-core": ["./packages/core/src/index.ts"],
      "@mwillbanks/tuil-events": ["./packages/events/src/index.ts"],
      "@mwillbanks/tuil-plugin": ["./packages/plugin/src/index.ts"],
      "@mwillbanks/tuil-theme": ["./packages/theme/src/index.ts"],
      "@mwillbanks/tuil-focus": ["./packages/focus/src/index.ts"],
      "@mwillbanks/tuil-hotkeys": ["./packages/hotkeys/src/index.ts"],
      "@mwillbanks/tuil-form": ["./packages/form/src/index.tsx"],
      "@mwillbanks/tuil-operations": ["./packages/operations/src/index.ts"],
      "@mwillbanks/tuil-router": ["./packages/router/src/index.ts"],
      "@mwillbanks/tuil-workflow": ["./packages/workflow/src/index.ts"],
      "@mwillbanks/tuil-virtual": ["./packages/virtual/src/index.ts"],
      "@mwillbanks/tuil-ink": ["./packages/ink/src/index.ts"],
      "@mwillbanks/tuil-testing": ["./packages/testing/src/index.ts"],
      "@mwillbanks/tuil-testing-ink": ["./packages/testing-ink/src/index.ts"],
      "@mwillbanks/tuil-registry": ["./packages/registry/src/index.ts"],
      "@mwillbanks/tuil-story": ["./packages/story/src/index.tsx"],
      "@mwillbanks/tuil-story/browser": ["./packages/story/src/browser.tsx"],
      "@mwillbanks/tuil-story/storybook": [
        "./packages/story/src/storybook.tsx"
      ],
      "@mwillbanks/tuil-story/static": ["./packages/story/src/static.ts"],
      "@mwillbanks/tuil-devtools": ["./packages/devtools/src/index.tsx"],
      "@mwillbanks/tuil-renderer": ["./packages/renderer/src/index.ts"],
      "@mwillbanks/tuil-cell": ["./packages/cell/src/index.ts"],
      "@mwillbanks/tuil-pointer": ["./packages/pointer/src/index.ts"],
      "@mwillbanks/tuil-scroll": ["./packages/scroll/src/index.ts"],
      "@mwillbanks/tuil-editor": ["./packages/editor/src/index.ts"],
      "@mwillbanks/tuil-editor/buffer": ["./packages/editor/src/buffer.ts"],
      "@mwillbanks/tuil-editor/vim": ["./packages/editor/src/vim.ts"],
      "@mwillbanks/tuil-editor/rich": ["./packages/editor/src/rich.ts"],
      "@mwillbanks/tuil-editor/testing": ["./packages/editor/src/testing.ts"],
      "@mwillbanks/tuil-streaming": ["./packages/streaming/src/index.ts"],
      "@mwillbanks/tuil-code": ["./packages/code/src/index.ts"],
      "@mwillbanks/tuil-content": ["./packages/content/src/index.ts"],
      "@mwillbanks/tuil-logging": ["./packages/logging/src/index.ts"],
      "@mwillbanks/tuil-log-viewer": ["./packages/log-viewer/src/index.tsx"],
      "@mwillbanks/tuil-protocol": ["./packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "registry/**/*.ts",
    "registry/**/*.tsx",
    "tooling/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "tuil.workspace.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
